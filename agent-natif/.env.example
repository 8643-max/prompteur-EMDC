# Cœur de l'agent natif EMDC Copilote — variables d'environnement
# Copiez ce fichier en .env et renseignez vos vraies valeurs. Le .env ne DOIT JAMAIS être commité.
# /!\ Ne mettre aucun secret dans le code ni dans le front.

# Port du serveur
PORT=3100

# ===== Cerveau interchangeable (celui par défaut) =====
# fournisseur : deepseek | anthropic | mistral | groq | openrouter | openai
LLM_FOURNISSEUR=deepseek
LLM_MODELE=deepseek-chat
# Clé API du fournisseur choisi
LLM_API_KEY=
# Pour les fournisseurs compatibles OpenAI, si l'adresse diffère (optionnel)
LLM_BASE_URL=

# ===== Supabase (base + auth + storage) =====
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_DB_URL=postgresql://…

# ===== Sécurité des endpoints =====
# Secret partagé pour signer les requêtes du front vers le cœur (HMAC)
AGENT_SIGNING_SECRET=

# ===== Divers =====
# Intervalle en ms du sentinelle de santé (défaut 5 min)
SENTINEL_INTERVAL_MS=300000
